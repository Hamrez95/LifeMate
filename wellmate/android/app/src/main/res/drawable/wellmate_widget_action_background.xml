<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp" />
            <solid android:color="#C94E46" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp" />
            <gradient android:angle="0" android:startColor="#FF7A68" android:centerColor="#FF6B5D" android:endColor="#FF5C52" />
            <stroke android:width="1dp" android:color="#FF9A8B" />
        </shape>
    </item>
    <item android:left="4dp" android:right="4dp" android:top="4dp" android:bottom="30dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="270" android:startColor="#45FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
