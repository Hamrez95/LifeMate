<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="7dp">

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/wellmate_widget_root_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.08"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:background="@drawable/wellmate_widget_card_background">

            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="match_parent"
                android:background="@drawable/wellmate_widget_mint_panel">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="✦"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="43dp"
                    android:layout_marginTop="36dp"
                    android:gravity="center"
                    android:text="✦"
                    android:textColor="#F7FFF9"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/widget_capsule_art"
                    android:layout_width="94dp"
                    android:layout_height="94dp"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_capsule_disc" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layoutDirection="rtl">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="42dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="9dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="نشان داروی بعدی"
                    android:src="@drawable/widget_bookmark_heart" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layoutDirection="rtl"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="11dp"
                    android:paddingEnd="13dp"
                    android:paddingBottom="9dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="30dp"
                        android:fontFamily="@font/vazir"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="داروی بعدی"
                        android:textColor="#F07161"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/widget_treatment_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/vazir_bold"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="#263345"
                        android:textSize="21sp" />

                    <TextView
                        android:id="@+id/widget_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/vazir"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="#7D7F83"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="7dp"
                        android:layoutDirection="rtl"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/wellmate_widget_chip_background">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="تعداد"
                            android:scaleType="fitCenter"
                            android:src="@drawable/widget_shield_medical" />

                        <TextView
                            android:id="@+id/widget_quantity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/vazir"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="—"
                            android:textColor="#55585D"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="5dp"
                        android:layoutDirection="rtl"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/wellmate_widget_chip_background">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="دوز"
                            android:scaleType="fitCenter"
                            android:src="@drawable/widget_capsule_green" />

                        <TextView
                            android:id="@+id/widget_dose"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/vazir"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="—"
                            android:textColor="#55585D"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.92"
            android:layout_marginTop="8dp"
            android:layoutDirection="rtl"
            android:orientation="vertical"
            android:paddingStart="11dp"
            android:paddingTop="9dp"
            android:paddingEnd="11dp"
            android:paddingBottom="9dp"
            android:background="@drawable/wellmate_widget_countdown_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="rtl"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="زمان مصرف"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_alarm_clock" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/vazir"
                    android:text="زمان مصرف"
                    android:textColor="#353A3F"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/vazir_bold"
                    android:text="—"
                    android:textColor="#353A3F"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layoutDirection="ltr"
                android:gravity="center"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <Chronometer
                        android:id="@+id/widget_countdown"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/vazir_bold"
                        android:fontFeatureSettings="locl"
                        android:gravity="center"
                        android:textColor="#F26354"
                        android:textLocale="fa-IR"
                        android:textSize="34sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_countdown_static"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/vazir_bold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="#F26354"
                        android:textLocale="fa-IR"
                        android:textSize="26sp" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/widget_alarm_art"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="5dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_alarm_clock" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_take_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layoutDirection="rtl"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/wellmate_widget_action_background">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/wellmate_widget_check_circle">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/vazir_bold"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="#F26354"
                        android:textSize="22sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/widget_action_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/vazir_bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="مصرف کردم"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_empty_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="rtl"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="22dp"
        android:background="@drawable/wellmate_widget_root_background"
        android:visibility="gone">

        <ImageView
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:contentDescription="WellMate"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/vazir_bold"
            android:gravity="center"
            android:text="برنامه بعدی در راه است"
            android:textColor="#263345"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/vazir"
            android:gravity="center"
            android:text="برای دیدن برنامه درمان، WellMate را باز کنید."
            android:textColor="#7D7F83"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
